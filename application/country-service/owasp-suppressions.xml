<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check Suppression File
  ========================================
  Documents accepted / triaged CVEs for the country-service backend.

  Every suppression MUST include a <notes> justification explaining WHY the
  finding is accepted (false positive, dev/test-only scope, or unfixable
  transitive with compensating control). This keeps the security gate honest:
  findings are consciously triaged, not silently ignored.

  Fixable CVEs are remediated in pom.xml (e.g. removing the pinned
  spring-boot-starter-security 2.7.0). Only genuinely-accepted findings belong
  here.

  Reference: https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      H2 database - the well-known H2 console CVEs (e.g. CVE-2021-42392,
      CVE-2022-23221) require the H2 web console to be exposed and reachable.
      In this project H2 is an IN-MEMORY, runtime-scoped dev database and the
      console is disabled by default in the container deployment
      (SPRING_H2_CONSOLE_ENABLED=false in docker-compose). It is never exposed
      in production. Accepted with compensating control; production migration to
      PostgreSQL is tracked in docs/architecture-design.md (Phase 2).
    -->
    <suppress>
        <notes><![CDATA[
            H2 console CVEs - console disabled in deployment; in-memory dev DB only.
            Compensating control documented; Phase 2 migrates to PostgreSQL.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <cve>CVE-2021-42392</cve>
        <cve>CVE-2022-23221</cve>
    </suppress>

    <!--
      spring-boot-devtools - DEV-ONLY dependency (optional, runtime scope) that
      is automatically excluded from the production fat JAR by Spring Boot. Any
      CVE here does not reach a built/deployed artifact. Accepted.
    -->
    <suppress>
        <notes><![CDATA[
            spring-boot-devtools is dev-only and excluded from the production JAR.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-devtools@.*$</packageUrl>
    </suppress>

</suppressions>
