# =============================================================================
# Environment variable template - copy to .env and fill in real values
# DO NOT commit .env to version control
# =============================================================================

# Spring Boot profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Database credentials - replace with strong values in production
DB_USERNAME=sa
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# H2 console - enable only in dev, disable in production
H2_CONSOLE_ENABLED=false

# Database URL (H2 in-memory for dev; switch to PostgreSQL for production)
DB_URL=jdbc:h2:mem:countriesdb

# Frontend -> Backend URL (as seen from the browser / host)
REACT_APP_API_URL=http://localhost:8081
